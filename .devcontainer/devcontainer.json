{
  "name": "Gold Store Codespace",
  "image": "mcr.microsoft.com/devcontainers/java:1-17-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/android-sdk:1": {
      "version": "34.0.0",
      "platform": "android-34"
    }
  },
  "containerEnv": {
    "ANDROID_HOME": "/usr/local/share/android-sdk",
    "ANDROID_SDK_ROOT": "/usr/local/share/android-sdk",
    "PATH": "${containerEnv:PATH}:/usr/local/share/android-sdk/cmdline-tools/latest/bin:/usr/local/share/android-sdk/platform-tools"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "vscjava.vscode-gradle",
        "fwcd.kotlin",
        "mathiasfrohlich.Kotlin"
      ]
    }
  },
  "postCreateCommand": "cd android && chmod +x gradlew"
}
